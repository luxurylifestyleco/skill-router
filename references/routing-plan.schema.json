{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedaxi.com/schemas/skill-router/routing-plan.v1.json",
  "title": "Skill Router plan",
  "description": "Provider-neutral output contract for Skill Router by @luxurylifestyleco / VEDAXI.",
  "type": "object",
  "required": ["version", "router", "message", "action_verb", "action_bucket", "risk", "status", "reason"],
  "properties": {
    "version": { "const": 1 },
    "router": {
      "type": "object",
      "required": ["name", "version", "author", "website"],
      "properties": {
        "name": { "const": "skill-router" },
        "version": { "type": "string" },
        "author": { "const": "luxurylifestyleco" },
        "website": { "const": "https://vedaxi.com" }
      },
      "additionalProperties": false
    },
    "id": { "type": "string" },
    "message": { "type": "string", "minLength": 1 },
    "action_verb": { "enum": ["sense", "understand", "decide", "create", "operate", "verify", "learn", "govern"] },
    "action_bucket": { "enum": ["data-enrichment", "orchestration", "utility", "verification"] },
    "risk": { "enum": ["routine", "human"] },
    "status": { "enum": ["routed", "blocked"] },
    "reason": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "title": "Automatic local discovery plan",
      "required": ["selectedSkills"],
      "properties": {
        "selectedSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "score", "matched"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "score": { "type": "number" },
              "matched": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "title": "Manifest policy routing plan",
      "required": ["agent", "skills", "primary", "supporting", "matchedRoutes", "explicitSkills", "unavailableSkills"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "primary": { "type": ["string", "null"] },
        "supporting": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "maxItems": 3 },
        "matchedRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score"],
            "properties": {
              "id": { "type": "string" },
              "score": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "explicitSkills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unavailableSkills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  ]
}
