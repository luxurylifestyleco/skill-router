{
  "version": 1,
  "settings": {
    "maxRoutes": 2,
    "minScore": 1
  },
  "fallback": {
    "agent": "general-agent",
    "skills": []
  },
  "routes": [
    {
      "id": "data-enrichment",
      "bucket": "data-enrichment",
      "agent": "research-agent",
      "skills": ["company-research", "contact-enrichment"],
      "priority": 110,
      "match": {
        "verbs": ["understand"],
        "any": ["enrich", "enrichment", "prospect list", "company funding", "contact details"],
        "patterns": ["\\b(funding|investors?|contacts?|firmographic)\\b"]
      }
    },
    {
      "id": "documents",
      "bucket": "utility",
      "agent": "document-agent",
      "skills": ["documents"],
      "priority": 100,
      "match": {
        "verbs": ["create"],
        "any": ["word document", "write a report", "edit a document"],
        "patterns": ["\\bdocx?\\b"],
        "extensions": [".docx"],
        "none": ["spreadsheet"]
      }
    },
    {
      "id": "spreadsheets",
      "bucket": "utility",
      "agent": "data-agent",
      "skills": ["spreadsheets"],
      "priority": 90,
      "match": {
        "verbs": ["create"],
        "any": ["spreadsheet", "excel", "workbook"],
        "patterns": ["\\b(xlsx|csv)\\b"],
        "extensions": [".xlsx", ".csv"]
      }
    },
    {
      "id": "presentations",
      "bucket": "utility",
      "agent": "presentation-agent",
      "skills": ["presentations"],
      "priority": 80,
      "match": {
        "verbs": ["create"],
        "any": ["slide deck", "presentation", "powerpoint"],
        "patterns": ["\\bpptx?\\b"],
        "extensions": [".pptx"]
      }
    },
    {
      "id": "dream",
      "bucket": "orchestration",
      "agent": "maintenance-agent",
      "skills": ["dream"],
      "priority": 70,
      "match": {
        "verbs": ["learn", "operate"],
        "any": ["dream", "maintenance cron"],
        "patterns": ["\\bdream\\b"]
      }
    }
  ]
}
